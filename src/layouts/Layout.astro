---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Balconería Omar — Herrería y soldadura en Aguascalientes",
  description = "Portones, puertas, escaleras y barandales de herrería a la medida. Más de 20 años de experiencia en Aguascalientes. Cotiza por WhatsApp.",
} = Astro.props;

const CANONICAL_URL = Astro.url.href;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111111" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={CANONICAL_URL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <!-- Borra los dos enlaces anteriores y pega solo este completo: -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&" />
  </head>

  <body>
    <Navbar />
    <main class="min-h-[calc(100vh-80px)]">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>


  *, *::before, *::after { 
    box-sizing: border-box; 
  }
  
  body {
     background: var(--carbon); 
     color: var(--cream); 
  }
</style>