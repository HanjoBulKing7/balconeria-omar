---
const baseUrl = import.meta.env.BASE_URL;
---

<!-- NAVBAR DESKTOP -->
<div class='bg-[var(--carbon) hidden md:flex h-fit w-full gap-4 items-center justify-between border-b border-amber-300 px-10 py-10 font-light tracking-wider'>
    <a href={`${baseUrl}`} class="flex flex-row gap-5">
        <h2 class="text-2xl text-white">Balconería</h2>
        <h2 class="text-2xl text-yellow-400">Omar</h2>
    </a>
    <ul class="flex flex-row gap-8">
        <li><a href={`${baseUrl}/services`} class="inline-block transition-all duration-300 hover:text-white hover:scale-110 hover:drop-shadow-[0_0_15px_rgba(250,204,21,0.8)] cursor-pointer">Servicios</a></li>
        <li><a href={`${baseUrl}/galeria`} class="inline-block transition-all duration-300 hover:text-white hover:scale-110 hover:drop-shadow-[0_0_15px_rgba(250,204,21,0.8)] cursor-pointer">Galería</a></li>
        <li><a href={`${baseUrl}/sobre-mi`} class="inline-block transition-all duration-300 hover:text-white hover:scale-110 hover:drop-shadow-[0_0_15px_rgba(250,204,21,0.8)] cursor-pointer">Sobre mí</a></li>
    </ul>
    <button class="text-black bg-amber-200 rounded-xl text-sm font-medium px-4 py-2 hover:bg-amber-300 transition-colors">
        Cotizar
    </button>
</div>

<!-- NAVBAR MÓVIL -->
<div class="bg-[var(--carbon) md:hidden font-light tracking-wider w-full">
    <!-- Barra superior -->
    <div class="flex items-center justify-between border-b border-amber-300 px-6 h-16">
        <a href={`${baseUrl}`} class="flex gap-2">
            <h2 class="text-xl text-white">Balconería</h2>
            <h2 class="text-xl text-yellow-400">Omar</h2>
        </a>
        <button id="menu-toggle" class="text-white">
            <span class="material-symbols-outlined text-white" id="menu-icon">menu</span>
        </button>
    </div>
    <!-- Menú desplegable -->
    <div id="mobile-menu" style="display: none;" class=" border-b border-amber-300">
        <ul class="flex flex-col items-center gap-4 px-6 py-4"> 
            <li><a href={`${baseUrl}/services`} class="text-white">Servicios</a></li>
            <li><a href={`${baseUrl}/galeria`} class="text-white">Galería</a></li>
            <li><a href={`${baseUrl}/sobre-mi`} class="text-white">Sobre mí</a></li>
            <li>        
                <button class="text-black bg-amber-200 rounded-xl text-sm px-4 py-2 w-fit">
                Cotizar
                </button>
            </li>
        </ul>

    </div>
</div>

<script>
    let isOpen = false;
    let menuIcon = 'menu'

    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const icon = document.getElementById('menu-icon');

    toggle?.addEventListener('click', () => {
        isOpen = !isOpen;

        menu!.style.display = isOpen ? 'flex' : 'none';
        menu!.style.flexDirection = 'column';
        icon!.textContent = isOpen ? 'close' : 'menu';
    });
</script>